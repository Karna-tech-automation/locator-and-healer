{
  "name": "locator-and-healer",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright locator finder, healer, and object repository Chrome extension",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,html,css}\"",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "@types/chrome": "0.0.287",
    "@types/node": "^26.6.6",
    "esbuild": "0.24.0",
    "eslint": "9.15.0",
    "prettier": "3.3.3",
    "typescript": "5.6.3",
    "typescript-eslint": "8.15.0",
    "vite": "5.4.11"
  },
  "dependencies": {
    "dom-to-locator": "^1.0.0"
  }
}
